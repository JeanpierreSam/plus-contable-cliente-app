-- Base local de la app (cliente.db). Mismas columnas que los DTO de DatosCliente (ver el contrato del backend).
-- Al pasar a la API, esta base queda como caché o se elimina.
-- Si cambia el esquema, desinstalar la app en desarrollo: no hay migraciones.

CREATE TABLE obligacion (
    id INTEGER NOT NULL PRIMARY KEY,
    tipoObligacion TEXT NOT NULL,
    periodo TEXT NOT NULL,
    fechaVencimiento TEXT NOT NULL,
    estado TEXT NOT NULL
);

CREATE TABLE cobro (
    id INTEGER NOT NULL PRIMARY KEY,
    fechaCobro TEXT NOT NULL,
    monto REAL NOT NULL,
    estado TEXT NOT NULL
);

CREATE TABLE fraccionamiento (
    id INTEGER NOT NULL PRIMARY KEY,
    tributo TEXT NOT NULL,
    montoTotal REAL NOT NULL,
    numeroCuotas INTEGER NOT NULL,
    fechaPrimeraCuota TEXT NOT NULL
);

CREATE TABLE cuota (
    id INTEGER NOT NULL PRIMARY KEY,
    fraccionamientoId INTEGER NOT NULL REFERENCES fraccionamiento(id),
    numero INTEGER NOT NULL,
    fechaVencimiento TEXT NOT NULL,
    monto REAL NOT NULL,
    estado TEXT NOT NULL,
    fechaPago TEXT,
    enRiesgo INTEGER NOT NULL -- 0 o 1
);

CREATE TABLE aviso (
    id INTEGER NOT NULL PRIMARY KEY,
    tipo TEXT NOT NULL,
    fechaRecepcion TEXT NOT NULL,
    plazoRespuesta TEXT,
    estado TEXT NOT NULL,
    fechaAtencion TEXT
);

CREATE TABLE documento (
    id INTEGER NOT NULL PRIMARY KEY,
    tipo TEXT NOT NULL,
    version INTEGER NOT NULL,
    fechaEmision TEXT,
    nombreArchivo TEXT NOT NULL,
    tamanoBytes INTEGER NOT NULL
);

CREATE TABLE incidencia (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    tipo TEXT NOT NULL,
    fecha TEXT NOT NULL,
    descripcion TEXT NOT NULL,
    registradaEn TEXT
);

obligaciones: SELECT * FROM obligacion ORDER BY fechaVencimiento DESC;
cobros: SELECT * FROM cobro ORDER BY fechaCobro;
fraccionamientos: SELECT * FROM fraccionamiento ORDER BY id;
cuotas: SELECT * FROM cuota ORDER BY numero;
totalObligaciones: SELECT COUNT(*) FROM obligacion;
insertarObligacion: INSERT OR REPLACE INTO obligacion VALUES (?, ?, ?, ?, ?);
insertarCobro: INSERT OR REPLACE INTO cobro VALUES (?, ?, ?, ?);
insertarFraccionamiento: INSERT OR REPLACE INTO fraccionamiento VALUES (?, ?, ?, ?, ?);
insertarCuota: INSERT OR REPLACE INTO cuota VALUES (?, ?, ?, ?, ?, ?, ?, ?);
incidencias: SELECT * FROM incidencia ORDER BY id DESC;
insertarIncidencia: INSERT INTO incidencia(tipo, fecha, descripcion, registradaEn) VALUES (?, ?, ?, ?);
documentos: SELECT * FROM documento ORDER BY tipo, version DESC;
insertarDocumento: INSERT OR REPLACE INTO documento VALUES (?, ?, ?, ?, ?, ?);
avisos: SELECT * FROM aviso ORDER BY fechaRecepcion DESC;
insertarAviso: INSERT OR REPLACE INTO aviso VALUES (?, ?, ?, ?, ?, ?);
